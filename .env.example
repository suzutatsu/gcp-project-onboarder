# Microsoft Teams Security Token (HMAC Key from Outgoing Webhook)
TEAMS_SECURITY_TOKEN="your_teams_outgoing_webhook_hmac_token_base64"

# Teams Admin Channel Incoming Webhook URL for approval requests
ADMIN_WEBHOOK_URL="https://yourdomain.webhook.office.com/webhookb2/..."

# Teams Request Channel Incoming Webhook URL for status notifications
NOTIFICATION_WEBHOOK_URL="https://yourdomain.webhook.office.com/webhookb2/..."

# Google Cloud Configuration
GCP_PROJECT_ID="your-gcp-project-id"
GCP_LOCATION="asia-northeast1"
GEMINI_MODEL_NAME="gemini-flash-lite"

# Default Target Google Group Email (Optional fixed fallback)
DEFAULT_GROUP_EMAIL="group-dev@company.com"

# LLM Cost Optimization Configuration (LLM_COST_ Prefix)
LLM_COST_ENABLE_CACHE="true"           # Enable LLM response caching (0 tokens on duplicate requests)
LLM_COST_CACHE_TTL_SECONDS="2592000"   # Cache TTL in seconds (default 30 days)
LLM_COST_MAX_OUTPUT_TOKENS="150"       # Cap Gemini output generation to minimize billing per request

# Secret Key for DB-less Signed Token generation (Leave blank for Ephemeral In-Memory Key)
SECRET_KEY=""

# Allowed Email Domains for Target Members (Comma-separated, optional guardrail)
ALLOWED_EMAIL_DOMAINS="example.com,yourdomain.com"
