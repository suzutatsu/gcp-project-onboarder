# Microsoft Teams 送信 Webhook (Outgoing Webhook) の HMAC セキュリティトークン
# ローカル開発: .env に記述 | 本番環境: Secret Manager (--set-secrets) 経由で注入
TEAMS_SECURITY_TOKEN="your_teams_outgoing_webhook_hmac_token_base64"

# 管理者チャネルの承認リクエスト用 Incoming Webhook (Workflows) URL
ADMIN_WEBHOOK_URL="https://yourdomain.webhook.office.com/webhookb2/..."

# 依頼結果通知チャネル用 Incoming Webhook (Workflows) URL
NOTIFICATION_WEBHOOK_URL="https://yourdomain.webhook.office.com/webhookb2/..."

# Google Cloud 設定 (GCP_PROJECT_ID はメタデータサーバーより自動判定されるため指定不要)
GCP_LOCATION="us"
GEMINI_MODEL_NAME="gemini-3.5-flash-lite"

# デフォルト対象 Google グループ（メッセージ内でグループが省略された場合の自動補完先）
DEFAULT_GROUP_EMAIL="group-dev@company.com"

# Gemini コスト最適化設定 (LLM_COST_ 接頭辞)
LLM_COST_ENABLE_CACHE="true"           # 自然言語パース結果のメモリキャッシュ有効化（重複申請のAPIトークン課金0円）
LLM_COST_CACHE_TTL_SECONDS="2592000"   # パース結果キャッシュの保持期間（秒・デフォルト30日間）
LLM_COST_MAX_OUTPUT_TOKENS="150"       # Gemini の応答生成トークン数上限キャップ（課金制御）

# 承認ボタン（トークン）の有効期限（秒・デフォルト3日間）
TOKEN_TTL_SECONDS="259200"

# DBレス承認トークン署名用の暗号鍵（空欄の場合はコンテナ起動時にRAM内で自動生成される256ビット暗号鍵を使用）
SECRET_KEY=""

# 申請を許可するメンバーのメールアドレスドメイン（カンマ区切り・空欄の場合はドメイン制限なし）
ALLOWED_EMAIL_DOMAINS="example.com,yourdomain.com"
